    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.4.2",
    "shadcn": "^4.21.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
